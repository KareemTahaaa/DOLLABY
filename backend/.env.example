# ════════════════════════════════════════════════════════════════════════════
# Dollaby Backend Configuration (.env.example)
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (Supabase)
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL — found in: Project Settings → API → Project URL
SUPABASE_URL="https://zhballeyetrijrjgemef.supabase.co"

# Supabase service role key (NOT anon key) — Settings → API → service_role
SUPABASE_SERVICE_KEY="your-service-role-key-here"

# ─────────────────────────────────────────────────────────────────────────────
# AI & LLM CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (for GPT-based fashion recommendations)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY_HERE"

# Groq API Key (faster, cost-effective LLM alternative)
# Get from: https://console.groq.com/keys
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY_HERE"

# ─────────────────────────────────────────────────────────────────────────────
# VIRTUAL TRY-ON CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# VITON_MODE options:
#   huggingface  — OOTDiffusion via HuggingFace Space (FREE, default)
#   catvton      — CatVTON via HuggingFace Space (FREE, 2024 diffusion model)
#   replicate    — IDM-VTON via Replicate API (paid, best quality)
#   colab        — OOTDiffusion on your Colab T4 GPU via ngrok
#   vitonhd      — VITON-HD (2021) on your Colab T4 GPU via ngrok
#   local        — HR-VITON running locally (needs GPU + checkpoints)
VITON_MODE=huggingface

# Replicate API Token (only needed if VITON_MODE=replicate)
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN="r8_YOUR_REPLICATE_TOKEN_HERE"

# Ngrok URL for OOTDiffusion on Colab (only if VITON_MODE=colab)
# Run: dollaby/backend/notebooks/Colab_HR_VITON_Server.ipynb
# COLAB_VITON_URL="https://YOUR-NGROK-URL.ngrok-free.app"

# Ngrok URL for VITON-HD on Colab (only if VITON_MODE=vitonhd)
# Run: dollaby/backend/notebooks/Colab_VITONHD_Server.ipynb
# VITONHD_COLAB_URL="https://YOUR-NGROK-URL.ngrok-free.app"

# ─────────────────────────────────────────────────────────────────────────────
# JWT & SECURITY CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Secret key for JWT token signing (use a strong random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"

# JWT token expiration time (in minutes)
JWT_EXPIRE_MINUTES=60

# Bcrypt hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Environment: development, staging, or production
ENVIRONMENT=development

# Server host and port
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: WEATHER API CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# OpenWeatherMap API Key (for weather-based outfit recommendations)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY="your_openweather_api_key_here"

# ─────────────────────────────────────────────────────────────────────────────
# FILE UPLOAD CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=20

# Allowed image file types
ALLOWED_IMAGE_TYPES="jpg,jpeg,png,webp"

# Upload directory path
UPLOAD_DIR="uploads"
