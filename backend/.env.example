# ════════════════════════════════════════════════════════════════════════════
# Dollaby Backend Configuration (.env.example)
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://[username]:[password]@[cluster].mongodb.net/?appName=[appName]
# Get this from: MongoDB Atlas → Cluster → Connect → Connection String
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/?appName=Dollaby"

# ─────────────────────────────────────────────────────────────────────────────
# AI & LLM CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (for GPT-based fashion recommendations)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY_HERE"

# Groq API Key (faster, cost-effective LLM alternative)
# Get from: https://console.groq.com/keys
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY_HERE"

# ─────────────────────────────────────────────────────────────────────────────
# VIRTUAL TRY-ON CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# VITON_MODE options:
#   - huggingface (DEFAULT - FREE, no setup needed)
#   - replicate (Paid API service, supports HR-VITON & IDM-VTON)
#   - local (Requires GPU, run HR-VITON locally)
VITON_MODE=huggingface

# Replicate API Token (only needed if VITON_MODE=replicate)
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN="r8_YOUR_REPLICATE_TOKEN_HERE"

# Optional: Ngrok URL for Colab VITON (only if VITON_MODE=colab)
# COLAB_VITON_URL="https://YOUR-NGROK-URL.ngrok-free.app"

# ─────────────────────────────────────────────────────────────────────────────
# JWT & SECURITY CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Secret key for JWT token signing (use a strong random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"

# JWT token expiration time (in minutes)
JWT_EXPIRE_MINUTES=60

# Bcrypt hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Environment: development, staging, or production
ENVIRONMENT=development

# Server host and port
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: WEATHER API CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# OpenWeatherMap API Key (for weather-based outfit recommendations)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY="your_openweather_api_key_here"

# ─────────────────────────────────────────────────────────────────────────────
# FILE UPLOAD CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=20

# Allowed image file types
ALLOWED_IMAGE_TYPES="jpg,jpeg,png,webp"

# Upload directory path
UPLOAD_DIR="uploads"
